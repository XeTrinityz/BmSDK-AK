{
  "plugins": ["sentence-case"],
  "packages": {
    ".": {
      "release-type": "simple",
      "bump-minor-pre-major": true,
      "bump-patch-for-minor-pre-major": false,
      "extra-files": [
        "src/BmSDK/BmSDK.csproj",
        "src/BmSDK.Manager/src-tauri/Cargo.toml",
        { "type": "json", "path": "src/BmSDK.Manager/src-tauri/tauri.conf.json", "jsonpath": "$.version" },
        { "type": "json", "path": "src/BmSDK.Manager/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "src/BmSDK.Manager/package-lock.json", "jsonpath": "$.version" },
        { "type": "json", "path": "src/BmSDK.Manager/package-lock.json", "jsonpath": "$.packages[''].version" },
        { "type": "toml", "path": "src/BmSDK.Manager/src-tauri/Cargo.lock", "jsonpath": "$.package[?(@.name.value=='bmsdk-manager')].version" }
      ],

      "changelog-path": "CHANGELOG.md",
      "include-commit-authors": true,

      "draft": true,
      "force-tag-creation": true,
      "prerelease": false
    }
  },
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json"
}
