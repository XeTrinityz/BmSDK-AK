{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BmSDK Manager",
  "mainBinaryName": "BmSDK-Manager",
  "version": "0.25.0",
  "identifier": "com.bmsdk.manager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "BmSDK Manager",
        "width": 1120,
        "height": 720,
        "minWidth": 1120,
        "minHeight": 720,
        "resizable": false,
        "maximizable": false,
        "decorations": false,
        "center": true,
        "dragDropEnabled": true,
        "backgroundColor": "#0a1322"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.ico"
    ]
  }
}
